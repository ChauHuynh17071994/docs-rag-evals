# Required only for the "claude" backend. The "extractive" backend runs fully offline.
ANTHROPIC_API_KEY=
RAG_MODEL=claude-sonnet-4-5
RAG_BACKEND=extractive
# bm25 | dense | hybrid
RAG_RETRIEVER=bm25
# 1 = rerank a candidate pool before keeping the top k
RAG_RERANK=0
# none | glossary | claude: rewrite short (<= 3 term) queries before retrieval
RAG_REWRITE=none
# DEBUG | INFO | WARNING: level of the JSON logs written to stderr
RAG_LOG_LEVEL=INFO
# Optional price override in USD per million tokens (defaults: list price table in rag/llm.py)
# RAG_PRICE_IN=3
# RAG_PRICE_OUT=15
